// For format details, see https://aka.ms/devcontainer.json
{
  "name": "Giardos Mod - Mindustry Java",

  // Imagen base con Java 17 preinstalado
  "image": "mcr.microsoft.com/devcontainers/java:1-17",

  // Features adicionales
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "false",
      "installGradle": "true"
    },
    "ghcr.io/devcontainers/features/android-sdk:1": {
      "version": "latest"
    }
  },

  // Variables de entorno del contenedor (disponibles en TODO el contenedor)
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "ANDROID_HOME": "/usr/local/android-sdk",
    "ANDROID_SDK_ROOT": "/usr/local/android-sdk"
  },

  // Variables de entorno para VS Code y terminales
  "remoteEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "ANDROID_HOME": "/usr/local/android-sdk",
    "ANDROID_SDK_ROOT": "/usr/local/android-sdk",
    "PATH": "/usr/lib/jvm/java-17-openjdk-amd64/bin:/usr/local/android-sdk/build-tools/34.0.0:${containerEnv:PATH}"
  },

  // Comando que se ejecuta despues de crear el contenedor
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Extensiones de VS Code utiles
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "redhat.java",
        "vscjava.vscode-java-debug"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/lib/jvm/java-17-openjdk-amd64",
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-17",
            "path": "/usr/lib/jvm/java-17-openjdk-amd64",
            "default": true
          }
        ]
      }
    }
  },

  // Usuario por defecto
  "remoteUser": "vscode"
}
