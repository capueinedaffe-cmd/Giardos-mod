{
  "name": "Giardos Mod",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": "true"
    }
  },

  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "ANDROID_HOME": "/usr/local/android-sdk",
    "ANDROID_SDK_ROOT": "/usr/local/android-sdk"
  },

  "remoteEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "PATH": "/usr/lib/jvm/java-17-openjdk-amd64/bin:/usr/local/android-sdk/build-tools/34.0.0:${containerEnv:PATH}"
  },

  "postCreateCommand": "chmod +x gradlew && java -version && echo '=== Giardos Mod listo ==='",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  }
}
